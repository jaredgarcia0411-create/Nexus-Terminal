# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL via Neon (optional — app falls back to localStorage if not set)
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/nexus?sslmode=require&channel_binding=require
DATABASE_URL=

# Jarvis assistant (optional — enables LLM responses)
JARVIS_API_KEY=
JARVIS_API_BASE_URL=https://integrate.api.nvidia.com/v1
JARVIS_MODEL=deepseek-v3.2
JARVIS_MAX_CONTEXT_TOKENS=6000
JARVIS_USER_STORAGE_LIMIT_BYTES=104857600
JARVIS_ADMIN_KEY=
JARVIS_EMBEDDING_ENABLED=true
JARVIS_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
JARVIS_EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1/embeddings

# AI Providers
NVIDIA_API_KEY=

# Access Control (optional — comma-separated emails, empty = allow all)
ALLOWED_EMAILS=

# Jarvis Cron (required for macro headline scraping on Vercel)
CRON_SECRET=

# Jarvis Orchestration (optional — enables multi-step critique)
JARVIS_ORCHESTRATION_CRITIQUE=false

# Jarvis Scrape Cache TTL (optional — milliseconds, 0 = disabled)
JARVIS_SCRAPE_CACHE_TTL_WEB_MS=3600000
JARVIS_SCRAPE_CACHE_TTL_HEADLINE_MS=43200000
JARVIS_SCRAPE_CACHE_TTL_API_MS=86400000

# AskEdgar API (optional — enables dilution research)
ASKEDGAR_API_KEY=
ASKEDGAR_DAILY_LIMIT=100

# Jarvis Circuit Breaker (optional)
JARVIS_CIRCUIT_BREAKER_THRESHOLD=5
JARVIS_CIRCUIT_BREAKER_RESET_MS=60000

# Jarvis Rate Limiting (optional — per user, per hour)
JARVIS_RATE_LIMIT_PER_HOUR=30

# Jarvis Robots.txt Cache (optional — milliseconds)
JARVIS_ROBOTS_CACHE_TTL_MS=3600000
