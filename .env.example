# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL via Neon
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/nexus?sslmode=require&channel_binding=require
DATABASE_URL=

# LLM / Research (optional — enables AI-generated TLDR on research reports)
LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile

# Background LLM (required for /api/research-report — paid Groq key)
# Same pool the agent platform uses; site report endpoint reuses it via lane: 'background'.
BACKGROUND_LLM_API_KEY=
BACKGROUND_LLM_API_BASE_URL=https://api.together.xyz/v1
BACKGROUND_LLM_MODEL=MiniMaxAI/MiniMax-M2.7
BACKGROUND_LLM_TIMEOUT_MS=60000

# Access Control (optional — comma-separated emails, empty = allow all)
ALLOWED_EMAILS=

# Cron (required for Vercel cron auth - mdr-sweep, agent-retention)
CRON_SECRET=

# AskEdgar API (optional — enables dilution research)
ASKEDGAR_API_KEY=
# Max unique tickers looked up per day (API enforces 50 unique tickers/day)
ASKEDGAR_DAILY_LIMIT=50

# Market Data (Massive API)
MASSIVE_API_KEY=

# Trading View Session ID for Top Gainers
TRADINGVIEW_SESSION_ID=

# Agent Admin Key
AGENT_ADMIN_KEY=

# Agent Service key
AGENT_SERVICE_KEY=

# FRED API Key - For Macro Daily
FRED_API_KEY=

# EODHD News API Key
EODHD_API_KEY=
