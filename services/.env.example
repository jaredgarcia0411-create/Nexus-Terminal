# ──────────────────────────────────────────────
# Nexus Agent Services — Environment Variables
# Copy to services/.env and fill in all values
# ──────────────────────────────────────────────

# ── Database ──
DATABASE_URL=               # Neon pooled connection string (ends with ?sslmode=require)

# ── Discord Bot ──
DISCORD_BOT_TOKEN=          # Bot tab → Token
DISCORD_CLIENT_ID=          # General Information → Application ID
DISCORD_GUILD_ID=           # Right-click server icon → Copy Server ID

# ── Discord Webhooks ──
DISCORD_WEBHOOK_SCANS=              # #small-cap-scans channel webhook URL
DISCORD_WEBHOOK_RESEARCH=           # #small-cap-research channel webhook URL
DISCORD_WEBHOOK_SWING_SETUPS=       # #swing-setups channel webhook URL
DISCORD_WEBHOOK_SWING_ALERTS=       # #swing-alerts channel webhook URL
DISCORD_WEBHOOK_MACRO_DAILY=        # #macro-daily channel webhook URL
DISCORD_WEBHOOK_SYSTEM=             # #agent-system channel webhook URL

# ── LLM — Interactive Lane (Orchestrator chat, optimized for speed) ──
INTERACTIVE_LLM_API_KEY=            # Groq key for dev, NVIDIA for prod
INTERACTIVE_LLM_API_BASE_URL=https://api.groq.com/openai/v1
INTERACTIVE_LLM_MODEL=llama-3.3-70b-versatile

# ── LLM — Background Lane (specialist scans, optimized for cost/quality) ──
BACKGROUND_LLM_API_KEY=             # Groq key for dev, NVIDIA/DeepSeek for prod
BACKGROUND_LLM_API_BASE_URL=https://api.groq.com/openai/v1
BACKGROUND_LLM_MODEL=llama-3.3-70b-versatile

# ── External APIs ──
MASSIVE_API_KEY=            # Massive API (Polygon-compatible market data)
ASKEDGAR_API_KEY=           # AskEdgar dilution research API

# ── Agent Auth ──
AGENT_ADMIN_KEY=            # Generate with: openssl rand -hex 32
AGENT_SERVICE_KEY=          # Generate with: openssl rand -hex 32

# ── Runtime Config ──
AGENT_POLL_INTERVAL_MS=2000         # How often workers poll for jobs (ms)
MACRO_CRON_HOUR=8                   # Hour (UTC) for daily macro summary
TZ=America/New_York                 # Timezone for cron scheduling
